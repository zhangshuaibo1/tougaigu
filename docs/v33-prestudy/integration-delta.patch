+    # inertial motion settle before a second observation after that release.
+    await page.wait_for_timeout(220)
+    assert await arrived(),'soul must remain visibly above its unchanged body/cat'
+
+async def exercise_companion(browser,args,output,api):
+    """Use three fresh contexts; never close the caller's browser or import it."""
+    expected_version=getattr(args,'version',None)
+    assert isinstance(expected_version,str) and expected_version.strip(),'companion checks require an explicit args.version'
+    assert urlparse(args.url).scheme in ['http','https'],'current URL must use HTTP or HTTPS'
+    baseline=getattr(args,'companion_baseline',None)
