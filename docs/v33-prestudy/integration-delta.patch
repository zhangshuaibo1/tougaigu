+    out=Path(output)/'companion';out.mkdir(parents=True,exist_ok=True)
+    report={'schema':'companion-v33-1','status':'running','expectedVersion':expected_version,
+            'scope':'Fresh current-URL contexts with read-only app probes and original keyboard/touch/UI controls',
+            'baselineURL':baseline,'currentURL':args.url,'cases':[],
